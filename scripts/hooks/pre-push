#!/usr/bin/env bash
#
# pre-push — 保護ブランチへの push と force push を物理的にブロックする git フック。
#
# 目的:
#   AGENTS.md に書いた「保護ブランチ直 push 禁止 / force 禁止」は prose であり、
#   AI エージェントは無視しうる（=ステルスプッシュの原因）。このフックは git の
#   push アクション自体を止める「ハードストップの層」を担う。
#
# git が渡す stdin の各行フォーマット:
#   <local ref> <local sha> <remote ref> <remote sha>
#   （push 対象の ref ごとに 1 行。削除 push では local sha がゼロ埋め）
#
# 人間による意識的な上書き:
#   ALLOW_PROTECTED_PUSH=1 を付けて push すると本フックを通過する。
#   例: ALLOW_PROTECTED_PUSH=1 git push origin main
#   これは「人間が意識的に許可した」ことを示すための唯一の抜け道。
#
# 依存ゼロ・POSIX bash のみ。
set -u

ZERO_SHA="0000000000000000000000000000000000000000"

# 保護ブランチ名の集合（basename 比較）。
PROTECTED_BRANCHES="main master develop integration release"

# origin/HEAD が指す default ブランチも保護対象に加える（自動検出）。
default_ref="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
if [ -n "${default_ref}" ]; then
  # "origin/main" -> "main"
  default_branch="${default_ref#origin/}"
  PROTECTED_BRANCHES="${PROTECTED_BRANCHES} ${default_branch}"
fi

is_protected() {
  # $1 = ブランチ名（basename）
  local name="$1" p
  for p in ${PROTECTED_BRANCHES}; do
    [ "${name}" = "${p}" ] && return 0
  done
  return 1
}

block() {
  # $1 = 理由メッセージ
  echo "" >&2
  echo "🛑 push をブロックしました（Git 運用ガバナンス）" >&2
  echo "   理由: $1" >&2
  echo "" >&2
  echo "   ルール: 全ての変更は topic ブランチ + Pull Request 経由で。" >&2
  echo "           保護ブランチ直 push / force push は禁止です（AGENTS.md 参照）。" >&2
  echo "" >&2
  echo "   人間が意識的に上書きする場合のみ:" >&2
  echo "       ALLOW_PROTECTED_PUSH=1 git push ..." >&2
  echo "" >&2
  exit 1
}

# override が明示されていれば全通過（人間の意識的許可）。
if [ "${ALLOW_PROTECTED_PUSH:-}" = "1" ]; then
  echo "⚠️  ALLOW_PROTECTED_PUSH=1: ガバナンスチェックを人間の指示で上書きします。" >&2
  exit 0
fi

# stdin の各 push ref を検査。
blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # 空行や不正行はスキップ。
  [ -z "${remote_ref:-}" ] && continue

  # remote_ref: 例 "refs/heads/main"。ブランチ名を取り出す。
  remote_branch="${remote_ref#refs/heads/}"

  # 1) 保護ブランチへの push をブロック。
  if is_protected "${remote_branch}"; then
    echo "   → 対象: ${remote_ref}（保護ブランチ）" >&2
    blocked=1
  fi

  # 2) force push（非 fast-forward の上書き）を検出してブロック。
  #    remote_sha が既存 (非ゼロ) で、かつ remote_sha が local_sha の祖先でない場合は
  #    履歴の巻き戻し = force push とみなす。
  if [ "${local_sha}" != "${ZERO_SHA}" ] && [ "${remote_sha}" != "${ZERO_SHA}" ]; then
    if ! git merge-base --is-ancestor "${remote_sha}" "${local_sha}" 2>/dev/null; then
      echo "   → 対象: ${remote_ref}（非 fast-forward = force push の疑い）" >&2
      blocked=1
    fi
  fi
done

if [ "${blocked}" = "1" ]; then
  block "保護ブランチへの直接 push、または force push を検出しました。"
fi

exit 0
